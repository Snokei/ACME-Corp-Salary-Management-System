// Prisma Schema for ACME Salary Management System

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Employee {
  id                String   @id @default(uuid())
  employeeId        String   @unique
  firstName         String
  lastName          String
  email             String   @unique
  department        String
  role              String
  country           String
  city              String
  currency          String
  baseSalary        Float
  baseSalaryUSD     Float
  bonusUSD          Float
  payGrade          String
  gender            String
  hireDate          DateTime
  performanceRating Int      @default(3)
  status            String   @default("Active")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  salaryHistories   SalaryHistory[]

  @@index([department])
  @@index([country])
  @@index([baseSalaryUSD])
  @@index([payGrade])
  @@index([lastName])
  @@index([status])
}

model SalaryHistory {
  id            String   @id @default(uuid())
  employeeId    String
  employee      Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  amount        Float
  currency      String   @default("USD")
  amountUSD     Float
  effectiveDate DateTime
  reason        String
  notes         String?
  createdBy     String?
  createdAt     DateTime @default(now())

  @@index([employeeId, effectiveDate])
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
