// Prisma Schema for ACME Salary Management System

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Employee {
  id                String   @id @default(uuid())
  employeeId        String   @unique
  firstName         String
  lastName          String
  email             String   @unique
  department        String
  role              String
  country           String
  city              String
  currency          String
  baseSalary        Float
  baseSalaryUSD     Float
  bonusUSD          Float
  payGrade          String
  gender            String
  hireDate          DateTime
  performanceRating Int      @default(3)
  status            String   @default("Active")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  salaryHistories        SalaryHistory[]
  compensationPlanItems  CompensationPlanItem[]

  @@index([department])
  @@index([country])
  @@index([baseSalaryUSD])
  @@index([payGrade])
  @@index([lastName])
  @@index([status])
  @@index([status, department])
}

model SalaryHistory {
  id            String   @id @default(uuid())
  employeeId    String
  employee      Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  amount        Float
  currency      String   @default("USD")
  amountUSD     Float
  previousAmountUSD Float?
  effectiveDate DateTime
  reason        String
  notes         String?
  createdBy     String?
  createdAt     DateTime @default(now())

  @@index([employeeId, effectiveDate])
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model SalaryBand {
  id             String   @id @default(uuid())
  payGrade       String
  currency       String   @default("USD")
  minSalary      Float
  midpointSalary Float
  maxSalary      Float
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([payGrade, currency])
  @@index([payGrade])
}

model CompensationPlan {
  id             String                       @id @default(uuid())
  name           String
  fiscalYear     String
  totalBudgetUSD Float
  status         String                       @default("Draft")
  createdBy      String                       @default("Valentino Morales")
  createdAt      DateTime                     @default(now())
  updatedAt      DateTime                     @updatedAt
  departments    CompensationPlanDepartment[]
  items          CompensationPlanItem[]

  @@index([fiscalYear])
  @@index([status])
}

model CompensationPlanDepartment {
  id                 String           @id @default(uuid())
  planId             String
  plan               CompensationPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  department         String
  allocatedBudgetUSD Float
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@unique([planId, department])
  @@index([planId])
  @@index([department])
}

model CompensationPlanItem {
  id                 String           @id @default(uuid())
  planId             String
  plan               CompensationPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  employeeId         String
  employee           Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  currentSalaryUSD   Float
  proposedSalaryUSD  Float
  increaseAmountUSD  Float
  increasePercentage Float            @default(0)
  status             String           @default("Proposed")
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@unique([planId, employeeId])
  @@index([planId])
  @@index([employeeId])
}

model AuditLog {
  id           String   @id @default(uuid())
  userId       String?
  userName     String?
  userEmail    String?
  action       String
  entityType   String
  entityId     String?
  description  String
  previousData String?
  newData      String?
  metadata     String?
  createdAt    DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([entityType])
  @@index([entityId])
  @@index([createdAt])
}



